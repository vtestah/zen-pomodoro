#: features.js:469
msgid "Estimate:"
msgstr "Szacunek:"

#: features.js:500
msgid "Add"
msgstr "Dodaj"

#: features.js:509 features.js:537
msgid "No tasks to save"
msgstr "Brak zadań do zapisania"

#: features.js:516
#, javascript-format
msgid "Template saved: %s"
msgstr "Zapisano szablon: %s"

#: features.js:540
msgid "Save as template"
msgstr "Zapisz jako szablon"

#: features.js:541
msgid "Template name"
msgstr "Nazwa szablonu"

#: features.js:560
msgid "Save"
msgstr "Zapisz"

#: features.js:604
msgid "longer focus blocks suit deep work"
msgstr "dłuższe bloki skupienia sprzyjają głębokiej pracy"

#: features.js:605
msgid "the classic rhythm suits studying"
msgstr "klasyczny rytm sprzyja nauce"

#: features.js:606
msgid "a little more break time lets ideas settle"
msgstr "trochę dłuższa przerwa pozwala myślom się ułożyć"

#: features.js:607
msgid "shorter cycles keep small tasks moving"
msgstr "krótsze cykle pomagają posuwać drobne zadania"

#: features.js:608
msgid "a balanced rhythm"
msgstr "zrównoważony rytm"

#: features.js:609
#, javascript-format
msgid "Focus rhythm %d / %d / %d min — %s."
msgstr "Rytm skupienia %d / %d / %d min — %s."

#: features.js:615
#, javascript-format
msgid "Daily goal: %d focus blocks."
msgstr "Cel dzienny: %d bloków skupienia."

#: features.js:616
msgid "No daily goal yet — just getting a feel for it."
msgstr "Na razie bez celu dziennego — po prostu próbujemy."

#: features.js:627
msgid "Silent focus — no ticking or chimes."
msgstr "Ciche skupienie — bez tykania i sygnałów."

#: features.js:631
msgid "Soft brown-noise ambience while you focus."
msgstr "Łagodny brązowy szum podczas skupienia."

#: features.js:636
#, javascript-format
msgid "A gentle chime every %d min to mark time."
msgstr "Delikatny sygnał co %d min, by odmierzać czas."

#: features.js:641
msgid "Quiet, visual-only cues for a shared space."
msgstr "Ciche, wyłącznie wizualne wskazówki do wspólnej przestrzeni."

#: features.js:647
msgid "Notifications are muted while you focus."
msgstr "Powiadomienia są wyciszone podczas skupienia."

#: features.js:650
msgid "Distraction blocking is ready — add sites in Settings → Advanced."
msgstr ""
"Blokowanie rozpraszaczy gotowe — dodaj witryny w Ustawienia → Zaawansowane."

#: features.js:653
msgid "One-click start and a calm start ritual make it easier to begin."
msgstr "Start jednym kliknięciem i spokojny rytuał startu ułatwiają początek."

#: features.js:657
msgid "Breaks start on their own so you don't overwork."
msgstr "Przerwy zaczynają się same, byś się nie przepracował."

#: features.js:661
msgid "A calm theme, no ticking seconds and no end-of-timer rush."
msgstr "Spokojny motyw, bez tykania sekund i pośpiechu na końcu."

#: features.js:701
msgid "What will you mainly focus on?"
msgstr "Na czym głównie się skupisz?"

#: features.js:702
msgid "This shapes how long each focus block should be."
msgstr "Od tego zależy długość każdego bloku skupienia."

#: features.js:704
msgid "Deep work or coding"
msgstr "Głęboka praca lub kodowanie"

#: features.js:705
msgid "Studying or reading"
msgstr "Nauka lub czytanie"

#: features.js:706
msgid "Writing or creative work"
msgstr "Pisanie lub praca twórcza"

#: features.js:707
msgid "Lots of small tasks"
msgstr "Wiele drobnych zadań"

#: features.js:709
msgid "How long can you usually concentrate?"
msgstr "Jak długo zwykle potrafisz się skupić?"

#: features.js:710
msgid "Pick a length you can actually keep — it beats an ideal one."
msgstr "Wybierz długość, którą realnie wytrzymasz — lepsza niż idealna."

#: features.js:712
msgid "About 15 minutes"
msgstr "Około 15 minut"

#: features.js:713
msgid "About 25 minutes"
msgstr "Około 25 minut"

#: features.js:714
msgid "45 minutes or more"
msgstr "45 minut lub więcej"

#: features.js:715
msgid "I lose track of time when I'm in flow"
msgstr "Tracę poczucie czasu, gdy wpadnę w przepływ"

#: features.js:717
msgid "What gets in your way most?"
msgstr "Co najbardziej ci przeszkadza?"

#: features.js:718
msgid "I'll switch on the right help for this."
msgstr "Włączę odpowiednią pomoc na to."

#: features.js:720
msgid "Notifications and pings"
msgstr "Powiadomienia i sygnały"

#: features.js:721
msgid "Distracting websites"
msgstr "Rozpraszające witryny"

#: features.js:722
msgid "It's hard to get started"
msgstr "Trudno mi zacząć"

#: features.js:723
msgid "I forget to take breaks"
msgstr "Zapominam o przerwach"

#: features.js:724
msgid "Timers make me anxious"
msgstr "Minutniki mnie stresują"

#: features.js:726
msgid "What helps you concentrate?"
msgstr "Co pomaga ci się skupić?"

#: features.js:727
msgid "Sets the focus soundscape — change it anytime in Sounds."
msgstr ""
"Ustawia dźwięki skupienia — zmienisz je w każdej chwili w sekcji Dźwięki."

#: features.js:729
msgid "Silence"
msgstr "Cisza"

#: features.js:730
msgid "Soft background noise"
msgstr "Łagodny szum w tle"

#: features.js:731
msgid "A gentle chime to mark time"
msgstr "Delikatny sygnał odmierzający czas"

#: features.js:732
msgid "I share my space — keep it quiet"
msgstr "Dzielę przestrzeń — niech będzie cicho"

#: features.js:734
msgid "How much do you want to get done today?"
msgstr "Ile chcesz dziś zrobić?"

#: features.js:735
msgid "Sets your daily goal — no pressure, you can change it."
msgstr "Ustawia cel dzienny — bez presji, możesz go zmienić."

#: features.js:737
msgid "Just trying it out"
msgstr "Tylko próbuję"

#: features.js:738
msgid "A light day (about 4)"
msgstr "Lekki dzień (około 4)"

#: features.js:739
msgid "A full day (about 6)"
msgstr "Pełny dzień (około 6)"

#: features.js:740
msgid "A big push (about 8)"
msgstr "Duży wysiłek (około 8)"

#: features.js:756
msgid "Smart setup"
msgstr "Inteligentna konfiguracja"

#: features.js:765
msgid "Skip"
msgstr "Pomiń"

#: features.js:768
msgid "Let's tune Zen Pomodoro to you 🍅"
msgstr "Dostosujmy Zen Pomodoro do ciebie 🍅"

#: features.js:769
msgid ""
"Answer five quick questions and I'll build a focus setup that fits how you "
"work — your rhythm, sounds, breaks and the help you need. You can fine-tune "
"everything later in Settings."
msgstr ""
"Odpowiedz na pięć krótkich pytań, a przygotuję konfigurację skupienia "
"dopasowaną do tego, jak pracujesz — rytm, dźwięki, przerwy i potrzebną "
"pomoc. Wszystko dopracujesz później w Ustawieniach."

#: features.js:770
msgid "Let's go"
msgstr "Zaczynajmy"

#: features.js:776 features.js:792
msgid "Back"
msgstr "Wstecz"

#: features.js:777
msgid "Next"
msgstr "Dalej"

#: features.js:780
msgid "Your tailored setup 🍅"
msgstr "Twoja dopasowana konfiguracja 🍅"

#: features.js:781
msgid ""
"Based on your answers, here's what I'll set up. Apply it now, then tweak "
"anything in Settings."
msgstr ""
"Na podstawie twoich odpowiedzi oto, co skonfiguruję. Zastosuj teraz, a "
"później dopracuj cokolwiek w Ustawieniach."

#: features.js:793
msgid "Apply"
msgstr "Zastosuj"

#: features.js:794
msgid "Apply & start"
msgstr "Zastosuj i zacznij"

