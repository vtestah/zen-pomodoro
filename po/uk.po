#: features.js:201
#, javascript-format
msgid "%d focus blocks today — great work!"
msgstr "%d блоків фокусу сьогодні — чудова робота!"

#: features.js:203
#, javascript-format
msgid "🔥 %d-day streak"
msgstr "🔥 серія %d дн."

#: features.js:205
msgid "Daily goal reached 🍅"
msgstr "Денну ціль досягнуто 🍅"

#: features.js:438
msgid "Look ~20 ft away for 20 seconds — rest your eyes."
msgstr "Подивіться вдалечінь 20 секунд — дайте очам відпочити."

#: features.js:439
msgid "Stand up and stretch."
msgstr "Встаньте та потягніться."

#: features.js:440
msgid "Drink some water."
msgstr "Випийте води."

#: features.js:441
msgid "Look out a window and relax your shoulders."
msgstr "Подивіться у вікно та розслабте плечі."

#: features.js:442
msgid "Close your eyes and take a few slow breaths."
msgstr "Заплющте очі та зробіть кілька повільних вдихів."

#: features.js:445
msgid "Take a short walk."
msgstr "Трохи прогуляйтеся."

#: features.js:446
msgid "Step outside for some fresh air."
msgstr "Вийдіть подихати свіжим повітрям."

#: features.js:447
msgid "Stretch and move around a little."
msgstr "Потягніться та трохи порухайтеся."

#: features.js:448
msgid "Grab a snack and some water."
msgstr "Перекусіть та випийте води."

#: features.js:449
msgid "Rest your eyes and look into the distance."
msgstr "Дайте очам відпочити — подивіться вдалечінь."

#: features.js:460
msgid "New task"
msgstr "Нове завдання"

#: features.js:461
msgid "What do you want to work on?"
