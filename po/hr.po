#: features.js:709
msgid "How long can you usually concentrate?"
msgstr "Koliko se obično možete koncentrirati?"

#: features.js:710
msgid "Pick a length you can actually keep — it beats an ideal one."
msgstr ""
"Odaberite trajanje koje stvarno možete održati — bolje je od idealnog."

#: features.js:712
msgid "About 15 minutes"
msgstr "Oko 15 minuta"

#: features.js:713
msgid "About 25 minutes"
