#: features.js:719
msgid "longer focus blocks suit deep work"
msgstr "längre fokuspass passar djuparbete"

#: features.js:720
msgid "the classic rhythm suits studying"
msgstr "den klassiska rytmen passar studier"

#: features.js:721
msgid "a little more break time lets ideas settle"
msgstr "lite mer rast låter idéerna landa"

#: features.js:722
msgid "shorter cycles keep small tasks moving"
msgstr "kortare cykler håller småuppgifter i rörelse"

#: features.js:723
msgid "a balanced rhythm"
msgstr "en balanserad rytm"

#: features.js:724
#, javascript-format
msgid "Focus rhythm %d / %d / %d min — %s."
msgstr "Fokusrytm %d / %d / %d min — %s."

#: features.js:730
#, javascript-format
msgid "Daily goal: %d focus blocks."
msgstr "Dagligt mål: %d fokuspass."

#: features.js:731
msgid "No daily goal yet — just getting a feel for it."
msgstr "Inget dagligt mål än — vi känner bara in det."

#: features.js:742
msgid "Silent focus — no ticking or chimes."
msgstr "Tyst fokus — inget tickande eller pling."

#: features.js:746
msgid "Soft brown-noise ambience while you focus."
msgstr "Mjukt brunt brus medan du fokuserar."

#: features.js:751
#, javascript-format
msgid "A gentle chime every %d min to mark time."
msgstr "Ett mjukt pling var %d:e min för att markera tiden."

#: features.js:756
msgid "Quiet, visual-only cues for a shared space."
msgstr "Tysta, enbart visuella signaler för delade utrymmen."

#: features.js:762
msgid "Notifications are muted while you focus."
msgstr "Aviseringar tystas medan du fokuserar."

#: features.js:765
msgid "Distraction blocking is ready — add sites in Settings → Advanced."
msgstr ""
"Distraktionsblockering är klar — lägg till sajter i Inställningar → "
"Avancerat."

#: features.js:768
msgid "One-click start and a calm start ritual make it easier to begin."
msgstr "Start med ett klick och en lugn startritual gör det lättare att börja."

#: features.js:772
msgid "Breaks start on their own so you don't overwork."
msgstr "Rasterna startar av sig själva så att du inte överarbetar."

#: features.js:776
msgid "A calm theme, no ticking seconds and no end-of-timer rush."
msgstr "Ett lugnt tema, inga tickande sekunder och ingen stress på slutet."

#: features.js:816
msgid "What will you mainly focus on?"
msgstr "Vad ska du främst fokusera på?"

#: features.js:817
msgid "This shapes how long each focus block should be."
msgstr "Det avgör hur långt varje fokuspass bör vara."

#: features.js:819
msgid "Deep work or coding"
