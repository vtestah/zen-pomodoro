{
    "layout": {
        "type": "layout",
        "pages": [
            "timer",
            "panel",
            "hud",
            "appearance",
            "features",
            "sounds",
            "tools",
            "scripts"
        ],
        "timer": {
            "type": "page",
            "title": "Timer",
            "sections": [
                "sec_durations",
                "sec_behavior"
            ]
        },
        "panel": {
            "type": "page",
            "title": "Panel",
            "sections": [
                "sec_panel"
            ]
        },
        "hud": {
            "type": "page",
            "title": "Focus HUD",
            "sections": [
                "sec_hud"
            ]
        },
        "appearance": {
            "type": "page",
            "title": "Appearance",
            "sections": [
                "sec_theme",
                "sec_motion",
                "sec_preview"
            ]
        },
        "features": {
            "type": "page",
            "title": "Features",
            "sections": [
                "sec_goals",
                "sec_modes"
            ]
        },
        "sounds": {
            "type": "page",
            "title": "Sounds",
            "sections": [
                "sec_sounds"
            ]
        },
        "tools": {
            "type": "page",
            "title": "Focus tools",
            "sections": [
                "sec_tools",
                "sec_notify",
                "sec_blocking"
            ]
        },
        "scripts": {
            "type": "page",
            "title": "Scripts",
            "sections": [
                "sec_scripts"
            ]
        },
        "sec_durations": {
            "type": "section",
            "title": "Durations",
            "keys": [
                "pomodoro_duration",
                "short_break_duration",
                "long_break_duration",
                "pomodori_number"
            ]
        },
        "sec_behavior": {
            "type": "section",
            "title": "Behavior",
            "keys": [
                "start_automatically_on_load",
                "session_recovery",
                "show_dialog_messages",
                "auto_start_after_pomodoro_ends",
                "auto_start_after_short_break_ends",
                "auto_start_after_break_ends"
            ]
        },
        "sec_panel": {
            "type": "section",
            "title": "Panel",
            "keys": [
                "display_icon",
                "use_symbolic_icon",
                "show_timer",
                "panel_progress_icon",
                "hotkey"
            ]
        },
        "sec_hud": {
            "type": "section",
            "title": "Focus HUD",
            "keys": [
                "focus_show_task_chip",
                "focus_calm_ending",
                "focus_start_ritual",
                "preset_tasks",
                "require_focus_task"
            ]
        },
        "sec_theme": {
            "type": "section",
            "title": "Theme & frame",
            "keys": [
                "theme_preset",
                "accent_focus_color",
                "accent_break_color",
                "frame_style",
                "glow_intensity",
                "glow_progress_width"
            ]
        },
        "sec_motion": {
            "type": "section",
            "title": "Motion & menu",
            "keys": [
                "breathing_pattern",
                "chip_position",
                "ritual_seconds",
                "reduce_motion",
                "menu_font_scale"
            ]
        },
        "sec_preview": {
            "type": "section",
            "title": "Preview",
            "keys": [
                "preview_appearance_button",
                "preview_breathing_button"
            ]
        },
        "sec_goals": {
            "type": "section",
            "title": "Goals & flow",
            "keys": [
                "daily_goal",
                "auto_pause_idle",
                "auto_pause_idle_minutes",
                "auto_resume_on_activity",
                "flow_extend",
                "flow_extend_minutes"
            ]
        },
        "sec_modes": {
            "type": "section",
            "title": "Ambient & modes",
            "keys": [
                "focus_ambient_sound",
                "focus_ambient_volume",
                "break_breathing",
                "zen_mode_enabled",
                "focus_until_enabled",
                "focus_dnd"
            ]
        },
        "sec_sounds": {
            "type": "section",
            "title": "Sounds",
            "keys": [
                "sox-info",
                "show_sox_info",
                "timer_sound",
                "timer_sound_file",
                "timer_sound_volume",
                "break_sound",
                "break_sound_file",
                "break_sound_volume",
                "warn_sound",
                "warn_sound_delay",
                "warn_sound_file",
                "warn_sound_volume",
                "start_sound",
                "start_sound_file",
                "start_sound_volume",
                "interval_chime",
                "interval_chime_seconds",
                "interval_chime_file",
                "interval_chime_volume"
            ]
        },
        "sec_tools": {
            "type": "section",
            "title": "Run a command on focus / break start",
            "keys": [
                "run_command_enabled",
                "focus_start_command",
                "break_start_command"
            ]
        },
        "sec_notify": {
            "type": "section",
            "title": "Push notifications (Pushover)",
            "keys": [
                "pushover_enabled",
                "pushover_user_key",
                "pushover_app_token"
            ]
        },
        "sec_blocking": {
            "type": "section",
            "title": "Distraction blocking (advanced)",
            "keys": [
                "enable_blocking",
                "block_domains",
                "block_now_button",
                "unblock_button",
                "edit_hosts_button"
            ]
        },
        "sec_scripts": {
            "type": "section",
            "title": "Scripts",
            "keys": [
                "enable_scripts",
                "custom_short_break_script",
                "custom_long_break_script"
            ]
        }
    },
    "pomodoro_duration": {
        "type": "scale",
        "default": 25,
        "min": 1,
        "max": 60,
        "step": 1,
        "description": "Pomodoro Duration:"
    },
    "short_break_duration": {
        "type": "scale",
        "default": 5,
        "min": 1,
        "max": 15,
        "step": 1,
        "description": "Short Break Duration:"
    },
    "long_break_duration": {
        "type": "scale",
        "default": 15,
        "min": 1,
        "max": 60,
        "step": 1,
        "description": "Long Break Duration:"
    },
    "pomodori_number": {
        "type": "scale",
        "default": 4,
        "min": 1,
        "max": 10,
        "step": 1,
        "description": "Number of pomodori before long break:"
    },
    "start_automatically_on_load": {
        "type": "checkbox",
        "description": "Start the pomodoro timer as soon as the applet loads",
        "default": false
    },
    "session_recovery": {
        "type": "checkbox",
        "description": "Recover an in-progress focus session after a Cinnamon restart (resume manually)",
        "default": true
    },
    "show_dialog_messages": {
        "type": "checkbox",
        "description": "Show Dialog Messages",
        "default": true
    },
    "auto_start_after_pomodoro_ends": {
        "type": "checkbox",
        "description": "Auto start after a pomodoro ends",
        "default": true
    },
    "auto_start_after_short_break_ends": {
        "type": "checkbox",
        "description": "Auto start after a short break ends",
        "default": true
    },
    "auto_start_after_break_ends": {
        "type": "checkbox",
        "description": "Auto start a new pomodoro after a break ends",
        "default": true
    },
    "display_icon": {
        "type": "checkbox",
        "description": "Display the pomodoro icon in the applet panel",
        "default": true
    },
    "use_symbolic_icon": {
        "type": "checkbox",
        "description": "Use a symbolic icon in the applet panel",
        "default": true
    },
    "show_timer": {
        "type": "checkbox",
        "description": "Show the pomodoro timer in the applet panel",
        "default": true
    },
    "hotkey": {
        "type": "keybinding",
        "description": "Set the keybinding to open the applet menu",
        "default": "<Super><Shift>p"
    },
    "focus_show_task_chip": {
        "type": "checkbox",
        "description": "Show the current task as an on-screen chip during focus",
        "default": false
    },
    "focus_calm_ending": {
        "type": "checkbox",
        "description": "Calm ending: no anxious pulsing near the end of a timer",
        "default": true
    },
    "focus_start_ritual": {
        "type": "checkbox",
        "description": "Start ritual: brief centered 'Focus: <task>' and a smooth fade-in when focus begins",
        "default": true
    },
    "preset_tasks": {
        "type": "list",
        "description": "Preset focus tasks (quick-pick buttons in the focus dialog)",
        "columns": [
            {
                "id": "task",
                "title": "Task",
                "type": "string"
            }
        ],
        "default": [
            {
                "task": "Планирование"
            },
            {
                "task": "Код"
            },
            {
                "task": "Тексты"
            },
            {
                "task": "Учеба"
            },
            {
                "task": "Разбор задач"
            },
            {
                "task": "Изучение Pytest"
            }
        ]
    },
    "require_focus_task": {
        "type": "checkbox",
        "description": "Require a focus task before starting",
        "default": false
    },
    "theme_preset": {
        "type": "combobox",
        "description": "Color theme",
        "default": "warm",
        "options": {
            "Warm (amber / green)": "warm",
            "Cool (teal)": "cool",
            "Monochrome": "mono",
            "Custom": "custom"
        }
    },
    "accent_focus_color": {
        "type": "colorchooser",
        "description": "Custom focus accent color",
        "default": "rgb(235,175,75)",
        "dependency": "theme_preset=custom"
    },
    "accent_break_color": {
        "type": "colorchooser",
        "description": "Custom break accent color",
        "default": "rgb(120,205,155)",
        "dependency": "theme_preset=custom"
    },
    "frame_style": {
        "type": "combobox",
        "description": "On-screen focus frame style",
        "default": "glow",
        "options": {
            "Glow": "glow",
            "Classic border": "border",
            "Corners only": "corners",
            "Off": "off"
        }
    },
    "glow_intensity": {
        "type": "scale",
        "default": 18,
        "min": 5,
        "max": 60,
        "step": 1,
        "description": "Glow intensity"
    },
    "glow_progress_width": {
        "type": "scale",
        "default": 2,
        "min": 1,
        "max": 6,
        "step": 1,
        "description": "Progress line thickness"
    },
    "breathing_pattern": {
        "type": "combobox",
        "description": "Breathing pattern",
        "default": "box",
        "options": {
            "Box 4-4-4-4": "box",
            "4-7-8": "478",
            "Relaxing 4-6": "relax"
        }
    },
    "chip_position": {
        "type": "combobox",
        "description": "Task chip position",
        "default": "br",
        "options": {
            "Bottom-right": "br",
            "Bottom-left": "bl",
            "Top-right": "tr",
            "Top-left": "tl"
        }
    },
    "ritual_seconds": {
        "type": "scale",
        "default": 4,
        "min": 1,
        "max": 8,
        "step": 1,
        "description": "Start ritual duration (seconds)"
    },
    "reduce_motion": {
        "type": "checkbox",
        "description": "Reduce motion (disable focus animations)",
        "default": false
    },
    "menu_font_scale": {
        "type": "scale",
        "default": 100,
        "min": 80,
        "max": 140,
        "step": 5,
        "description": "Menu font scale (%)"
    },
    "preview_appearance_button": {
        "type": "button",
        "description": "Preview focus frame",
        "callback": "_previewAppearance",
        "tooltip": "Briefly show the on-screen focus frame and task chip with the current colors and style (works when no timer is running)."
    },
    "preview_breathing_button": {
        "type": "button",
        "description": "Preview breathing guide",
        "callback": "_previewBreathing",
        "tooltip": "Briefly show the breathing guide with the selected pattern."
    },
    "panel_progress_icon": {
        "type": "checkbox",
        "description": "Show timer progress as a ring on the panel icon",
        "default": true
    },
    "daily_goal": {
        "type": "scale",
        "default": 0,
        "min": 0,
        "max": 16,
        "step": 1,
        "description": "Daily focus goal (pomodori, 0 = off)"
    },
    "auto_pause_idle": {
        "type": "checkbox",
        "description": "Auto-pause focus when you are away (idle)",
        "default": false
    },
    "auto_pause_idle_minutes": {
        "type": "scale",
        "default": 5,
        "min": 1,
        "max": 30,
        "step": 1,
        "description": "Idle minutes before auto-pause",
        "dependency": "auto_pause_idle"
    },
    "auto_resume_on_activity": {
        "type": "checkbox",
        "description": "Resume automatically when you return",
        "default": false,
        "dependency": "auto_pause_idle"
    },
    "flow_extend": {
        "type": "checkbox",
        "description": "Offer to extend focus when a pomodoro ends (stay in flow)",
        "default": true
    },
    "flow_extend_minutes": {
        "type": "scale",
        "default": 5,
        "min": 1,
        "max": 30,
        "step": 1,
        "description": "Extend amount (minutes)",
        "dependency": "flow_extend"
    },
    "focus_ambient_sound": {
        "type": "checkbox",
        "description": "Play soft ambient (brown noise) during focus",
        "default": false
    },
    "focus_ambient_volume": {
        "type": "scale",
        "default": 40,
        "min": 1,
        "max": 100,
        "step": 1,
        "description": "Ambient volume",
        "dependency": "focus_ambient_sound"
    },
    "break_breathing": {
        "type": "checkbox",
        "description": "Show a breathing guide during breaks",
        "default": false
    },
    "zen_mode_enabled": {
        "type": "checkbox",
        "description": "Enable Zen mode (full-screen focus overlay, toggled from the menu)",
        "default": false
    },
    "focus_until_enabled": {
        "type": "checkbox",
        "description": "Show 'Focus until…' in the menu (focus until a clock time)",
        "default": false
    },
    "focus_dnd": {
        "type": "checkbox",
        "description": "Mute notifications while focusing (Do Not Disturb)",
        "default": false
    },
    "run_command_enabled": {
        "type": "checkbox",
        "description": "Run a command when focus or a break starts",
        "default": false
    },
    "focus_start_command": {
        "type": "entry",
        "description": "Command to run when focus starts",
        "default": "",
        "dependency": "run_command_enabled"
    },
    "break_start_command": {
        "type": "entry",
        "description": "Command to run when a break starts",
        "default": "",
        "dependency": "run_command_enabled"
    },
    "pushover_enabled": {
        "type": "checkbox",
        "description": "Send a push notification (Pushover) on breaks",
        "default": false
    },
    "pushover_user_key": {
        "type": "entry",
        "description": "Pushover user key",
        "default": "",
        "dependency": "pushover_enabled"
    },
    "pushover_app_token": {
        "type": "entry",
        "description": "Pushover application API token",
        "default": "",
        "dependency": "pushover_enabled"
    },
    "enable_blocking": {
        "type": "checkbox",
        "description": "Enable distraction blocking (edits /etc/hosts via an admin prompt)",
        "default": false
    },
    "block_domains": {
        "type": "list",
        "description": "Domains to block (e.g. youtube.com)",
        "columns": [
            {
                "id": "domain",
                "title": "Domain",
                "type": "string"
            }
        ],
        "default": [],
        "dependency": "enable_blocking"
    },
    "block_now_button": {
        "type": "button",
        "description": "Block these domains now",
        "callback": "_blockDistractions",
        "dependency": "enable_blocking",
        "tooltip": "Adds the domains above to /etc/hosts (you'll be asked for your password once). They stay blocked until you click Unblock."
    },
    "unblock_button": {
        "type": "button",
        "description": "Unblock",
        "callback": "_unblockDistractions",
        "dependency": "enable_blocking",
        "tooltip": "Removes Zen Pomodoro's block entries from /etc/hosts (asks for your password once)."
    },
    "edit_hosts_button": {
        "type": "button",
        "description": "Edit /etc/hosts manually (admin)",
        "callback": "_editHostsAsAdmin",
        "dependency": "enable_blocking",
        "tooltip": "Opens /etc/hosts in your editor with administrator rights. Zen Pomodoro only manages its own clearly-marked section."
    },
    "sox-info": {
        "type": "label",
        "description": "No sound backend was found. Install GSound or a sound player (e.g. the 'pulseaudio-utils' or 'sox' package) to enable sounds.",
        "dependency": "show_sox_info"
    },
    "show_sox_info": {
        "type": "generic",
        "default": false
    },
    "timer_sound": {
        "type": "checkbox",
        "description": "Play Timer Sound",
        "default": false
    },
    "timer_sound_file": {
        "type": "filechooser",
        "description": "Timer Sound File",
        "default": "tick.ogg",
        "select-dir": false,
        "dependency": "timer_sound"
    },
    "timer_sound_volume": {
        "type": "scale",
        "default": 100,
        "min": 1,
        "max": 100,
        "step": 1,
        "description": "Sound volume:",
        "dependency": "timer_sound"
    },
    "break_sound": {
        "type": "checkbox",
        "description": "Play Break Sound",
        "default": true
    },
    "break_sound_file": {
        "type": "filechooser",
        "description": "Break Sound File",
        "default": "deskbell.wav",
        "select-dir": false,
        "dependency": "break_sound"
    },
    "break_sound_volume": {
        "type": "scale",
        "default": 100,
        "min": 1,
        "max": 100,
        "step": 1,
        "description": "Sound volume:",
        "dependency": "break_sound"
    },
    "warn_sound": {
        "type": "checkbox",
        "description": "Play Warn Sound",
        "default": false
    },
    "warn_sound_delay": {
        "type": "scale",
        "default": 30,
        "min": 5,
        "max": 600,
        "step": 5,
        "description": "Warn Delay (in secs):",
        "dependency": "warn_sound"
    },
    "warn_sound_file": {
        "type": "filechooser",
        "description": "Warn Sound File",
        "default": "warn.wav",
        "select-dir": false,
        "dependency": "warn_sound"
    },
    "warn_sound_volume": {
        "type": "scale",
        "default": 100,
        "min": 1,
        "max": 100,
        "step": 1,
        "description": "Sound volume:",
        "dependency": "warn_sound"
    },
    "start_sound": {
        "type": "checkbox",
        "description": "Play Start Sound",
        "default": true
    },
    "start_sound_file": {
        "type": "filechooser",
        "description": "Start Sound File",
        "default": "deskbell.wav",
        "select-dir": false,
        "dependency": "start_sound"
    },
    "start_sound_volume": {
        "type": "scale",
        "default": 100,
        "min": 1,
        "max": 100,
        "step": 1,
        "description": "Sound volume:",
        "dependency": "start_sound"
    },
    "interval_chime": {
        "type": "checkbox",
        "description": "Play a chime at a regular interval during focus",
        "default": false
    },
    "interval_chime_seconds": {
        "type": "scale",
        "default": 60,
        "min": 10,
        "max": 600,
        "step": 5,
        "description": "Chime interval (seconds):",
        "dependency": "interval_chime"
    },
    "interval_chime_file": {
        "type": "filechooser",
        "description": "Chime sound file",
        "default": "tick.ogg",
        "select-dir": false,
        "dependency": "interval_chime"
    },
    "interval_chime_volume": {
        "type": "scale",
        "default": 80,
        "min": 1,
        "max": 100,
        "step": 1,
        "description": "Chime volume:",
        "dependency": "interval_chime"
    },
    "enable_scripts": {
        "type": "checkbox",
        "description": "Enable scripts",
        "default": false
    },
    "custom_short_break_script": {
        "type": "filechooser",
        "default": "",
        "description": "Execute this custom script when a short break starts",
        "select-dir": false,
        "dependency": "enable_scripts"
    },
    "custom_long_break_script": {
        "type": "filechooser",
        "default": "",
        "description": "Execute this custom script when a long break starts",
        "select-dir": false,
        "dependency": "enable_scripts"
    }
}
