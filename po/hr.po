#: features.js:604
msgid "longer focus blocks suit deep work"
msgstr "duži blokovi fokusa pogoduju dubokom radu"

#: features.js:605
msgid "the classic rhythm suits studying"
msgstr "klasični ritam pogoduje učenju"

#: features.js:606
msgid "a little more break time lets ideas settle"
msgstr "malo više predaha pomaže idejama da se slegnu"

#: features.js:607
msgid "shorter cycles keep small tasks moving"
msgstr "kraći ciklusi održavaju male zadatke u tijeku"

#: features.js:608
msgid "a balanced rhythm"
msgstr "uravnotežen ritam"

#: features.js:609
#, javascript-format
msgid "Focus rhythm %d / %d / %d min — %s."
msgstr "Ritam fokusa %d / %d / %d min — %s."

#: features.js:615
#, javascript-format
msgid "Daily goal: %d focus blocks."
msgstr "Dnevni cilj: %d blokova fokusa."

#: features.js:616
msgid "No daily goal yet — just getting a feel for it."
msgstr "Još bez dnevnog cilja — samo se privikavate."

#: features.js:627
msgid "Silent focus — no ticking or chimes."
msgstr "Tihi fokus — bez kucanja i zvonjave."

#: features.js:631
msgid "Soft brown-noise ambience while you focus."
msgstr "Mekani smeđi šum dok se fokusirate."

#: features.js:636
#, javascript-format
msgid "A gentle chime every %d min to mark time."
msgstr "Nježno zvonce svakih %d min za označavanje vremena."

#: features.js:641
msgid "Quiet, visual-only cues for a shared space."
msgstr "Tihi, samo vizualni znakovi za zajednički prostor."

#: features.js:647
msgid "Notifications are muted while you focus."
msgstr "Obavijesti su utišane dok se fokusirate."

#: features.js:650
msgid "Distraction blocking is ready — add sites in Settings → Advanced."
msgstr ""
"Blokiranje ometanja je spremno — dodajte stranice u Postavke → Napredno."

#: features.js:653
msgid "One-click start and a calm start ritual make it easier to begin."
msgstr "Pokretanje jednim klikom i smiren ritual početka olakšavaju početak."

#: features.js:657
msgid "Breaks start on their own so you don't overwork."
msgstr "Predasi počinju sami da se ne biste preopteretili."

#: features.js:661
msgid "A calm theme, no ticking seconds and no end-of-timer rush."
msgstr "Smirena tema, bez kucanja sekundi i bez žurbe na kraju mjerača."

#: features.js:701
msgid "What will you mainly focus on?"
msgstr "Na što ćete se uglavnom fokusirati?"

#: features.js:702
msgid "This shapes how long each focus block should be."
msgstr "Ovo određuje koliko bi trebao trajati svaki blok fokusa."

#: features.js:704
msgid "Deep work or coding"
msgstr "Dubok rad ili programiranje"

#: features.js:705
msgid "Studying or reading"
msgstr "Učenje ili čitanje"

#: features.js:706
msgid "Writing or creative work"
msgstr "Pisanje ili kreativni rad"

#: features.js:707
msgid "Lots of small tasks"
