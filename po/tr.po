#, javascript-format
msgid "Daily goal: %d focus blocks."
msgstr "Günlük hedef: %d odak bloğu."

#: features.js:616
msgid "No daily goal yet — just getting a feel for it."
msgstr "Henüz günlük hedef yok — sadece deniyoruz."

#: features.js:627
msgid "Silent focus — no ticking or chimes."
msgstr "Sessiz odak — tıkırtı ya da çınlama yok."

#: features.js:631
msgid "Soft brown-noise ambience while you focus."
msgstr "Odaklanırken yumuşak kahverengi gürültü ortamı."

