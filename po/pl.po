#. settings-schema.json->setup_passwordless_button->description
msgid "Set up passwordless blocking (one-time)"
msgstr "Skonfiguruj blokowanie bez hasła (jednorazowo)"

#. settings-schema.json->setup_passwordless_button->tooltip
msgid ""
"Asks for your password once and installs a small system policy so blocking "
"no longer prompts during focus."
msgstr ""
"Poprosi raz o hasło i zainstaluje małą regułę systemową, aby blokowanie nie "
"pytało o nie podczas skupienia."

#. settings-schema.json->remove_passwordless_button->description
msgid "Remove passwordless setup"
msgstr "Usuń konfigurację bez hasła"

#. settings-schema.json->remove_passwordless_button->tooltip
msgid ""
"Removes the system policy and the root helper, so blocking asks for your "
"password again each time."
msgstr ""
"Usuwa politykę systemową i pomocnika root, więc blokowanie znów będzie pytać "
"o hasło za każdym razem."

#. settings-schema.json->onboarding_button->description
