#: features.js:201
#, javascript-format
msgid "%d focus blocks today — great work!"
msgstr "%d помидоров сегодня — отличная работа!"

#: features.js:203
#, javascript-format
msgid "🔥 %d-day streak"
msgstr "🔥 серия %d дн."

#: features.js:205
msgid "Daily goal reached 🍅"
msgstr "Дневная цель достигнута 🍅"

#: features.js:420
#, javascript-format
msgid "Hit your %d 🍅 estimate for: %s. Mark it done when ready."
msgstr ""
"Достигнута оценка %d 🍅 для: %s. Отметьте выполненной, когда будете готовы."

#: features.js:455
msgid "Look ~20 ft away for 20 seconds — rest your eyes."
msgstr "Посмотрите вдаль на 20 секунд — дайте глазам отдохнуть."

#: features.js:456
msgid "Stand up and stretch."
msgstr "Встаньте и потянитесь."

#: features.js:457
msgid "Drink some water."
msgstr "Выпейте воды."

#: features.js:458
msgid "Look out a window and relax your shoulders."
msgstr "Посмотрите в окно и расслабьте плечи."

#: features.js:459
msgid "Close your eyes and take a few slow breaths."
msgstr "Закройте глаза и сделайте несколько медленных вдохов."

#: features.js:462
msgid "Take a short walk."
msgstr "Немного пройдитесь."

#: features.js:463
msgid "Step outside for some fresh air."
msgstr "Выйдите подышать свежим воздухом."

#: features.js:464
msgid "Stretch and move around a little."
msgstr "Потянитесь и немного подвигайтесь."

#: features.js:465
msgid "Grab a snack and some water."
msgstr "Перекусите и выпейте воды."

#: features.js:466
msgid "Rest your eyes and look into the distance."
msgstr "Дайте глазам отдохнуть — посмотрите вдаль."

#: features.js:477 menu.js:868
msgid "Edit task"
msgstr "Изменить задачу"

#: features.js:477
msgid "New task"
