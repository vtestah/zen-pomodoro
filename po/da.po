#: features.js:604
msgid "longer focus blocks suit deep work"
msgstr "længere fokusblokke passer til dybt arbejde"

#: features.js:605
msgid "the classic rhythm suits studying"
msgstr "den klassiske rytme passer til studier"

#: features.js:606
msgid "a little more break time lets ideas settle"
msgstr "lidt mere pausetid lader idéerne falde på plads"

#: features.js:607
msgid "shorter cycles keep small tasks moving"
msgstr "kortere cyklusser holder små opgaver i gang"

#: features.js:608
msgid "a balanced rhythm"
msgstr "en balanceret rytme"

#: features.js:609
#, javascript-format
msgid "Focus rhythm %d / %d / %d min — %s."
