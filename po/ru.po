msgid "Extend amount (minutes)"
msgstr "На сколько продлевать (минуты)"

msgid "Play soft ambient (brown noise) during focus"
msgstr "Тихий фон (коричневый шум) во время фокуса"

msgid "Ambient volume"
msgstr "Громкость фона"

msgid "Show a breathing guide during breaks"
msgstr "Показывать дыхательный гайд на перерывах"

msgid "Enable Zen mode (full-screen focus overlay, toggled from the menu)"
msgstr "Включить режим Дзен (полноэкранный оверлей фокуса, переключается из меню)"

msgid "Show 'Focus until…' in the menu (focus until a clock time)"
msgstr "Показывать «Фокус до…» в меню (фокус до времени)"

