#: features.js:201
#, javascript-format
msgid "%d focus blocks today — great work!"
msgstr "%d khối tập trung hôm nay — làm tốt lắm!"

#: features.js:203
#, javascript-format
msgid "🔥 %d-day streak"
msgstr "🔥 chuỗi %d ngày"

#: features.js:205
msgid "Daily goal reached 🍅"
msgstr "Đã đạt mục tiêu ngày 🍅"

#: features.js:438
msgid "Look ~20 ft away for 20 seconds — rest your eyes."
msgstr "Nhìn ra xa trong 20 giây — cho mắt nghỉ ngơi."

#: features.js:439
msgid "Stand up and stretch."
msgstr "Đứng dậy và vươn vai."

#: features.js:440
msgid "Drink some water."
msgstr "Uống chút nước."

#: features.js:441
msgid "Look out a window and relax your shoulders."
msgstr "Nhìn ra cửa sổ và thả lỏng vai."

#: features.js:442
msgid "Close your eyes and take a few slow breaths."
msgstr "Nhắm mắt và hít thở chậm vài hơi."

#: features.js:445
msgid "Take a short walk."
msgstr "Đi bộ một chút."

#: features.js:446
msgid "Step outside for some fresh air."
msgstr "Ra ngoài hít thở không khí trong lành."

#: features.js:447
msgid "Stretch and move around a little."
msgstr "Vươn vai và vận động một chút."

#: features.js:448
msgid "Grab a snack and some water."
msgstr "Ăn nhẹ và uống chút nước."

#: features.js:449
msgid "Rest your eyes and look into the distance."
msgstr "Cho mắt nghỉ và nhìn ra xa."

#: features.js:460
msgid "New task"
msgstr "Việc mới"

#: features.js:461
msgid "What do you want to work on?"
msgstr "Bạn muốn làm việc gì?"

#: features.js:469
msgid "Estimate:"
msgstr "Ước lượng:"

#: features.js:500
msgid "Add"
msgstr "Thêm"

#: features.js:509 features.js:537
msgid "No tasks to save"
msgstr "Không có việc nào để lưu"

#: features.js:516
#, javascript-format
msgid "Template saved: %s"
msgstr "Đã lưu mẫu: %s"

#: features.js:540
msgid "Save as template"
msgstr "Lưu thành mẫu"

#: features.js:541
msgid "Template name"
msgstr "Tên mẫu"

#: features.js:560
msgid "Save"
msgstr "Lưu"

#: features.js:604
msgid "longer focus blocks suit deep work"
msgstr "khối tập trung dài hơn hợp với công việc chuyên sâu"

#: features.js:605
msgid "the classic rhythm suits studying"
msgstr "nhịp cổ điển hợp với việc học"

#: features.js:606
msgid "a little more break time lets ideas settle"
msgstr "nghỉ thêm chút giúp ý tưởng lắng lại"

#: features.js:607
msgid "shorter cycles keep small tasks moving"
msgstr "chu kỳ ngắn giúp việc nhỏ tiến đều"

#: features.js:608
msgid "a balanced rhythm"
msgstr "một nhịp cân bằng"

#: features.js:609
#, javascript-format
msgid "Focus rhythm %d / %d / %d min — %s."
msgstr "Nhịp tập trung %d / %d / %d phút — %s."

#: features.js:615
#, javascript-format
msgid "Daily goal: %d focus blocks."
msgstr "Mục tiêu ngày: %d khối tập trung."

#: features.js:616
msgid "No daily goal yet — just getting a feel for it."
msgstr "Chưa có mục tiêu ngày — cứ thử làm quen đã."

#: features.js:627
msgid "Silent focus — no ticking or chimes."
msgstr "Tập trung yên tĩnh — không tiếng tích tắc hay chuông."

#: features.js:631
msgid "Soft brown-noise ambience while you focus."
msgstr "Tiếng ồn nâu nhẹ nhàng trong lúc bạn tập trung."

#: features.js:636
#, javascript-format
msgid "A gentle chime every %d min to mark time."
msgstr "Chuông nhẹ mỗi %d phút để đánh dấu thời gian."

#: features.js:641
msgid "Quiet, visual-only cues for a shared space."
msgstr "Gợi ý chỉ bằng hình ảnh, yên tĩnh cho không gian chung."

#: features.js:647
msgid "Notifications are muted while you focus."
msgstr "Tắt tiếng thông báo trong lúc bạn tập trung."

#: features.js:650
msgid "Distraction blocking is ready — add sites in Settings → Advanced."
msgstr "Đã sẵn sàng chặn xao nhãng — thêm trang trong Cài đặt → Nâng cao."

#: features.js:653
msgid "One-click start and a calm start ritual make it easier to begin."
msgstr ""
"Bắt đầu một chạm và nghi thức khởi đầu nhẹ nhàng giúp bạn dễ bắt tay vào "
"việc."

#: features.js:657
msgid "Breaks start on their own so you don't overwork."
msgstr "Giờ nghỉ tự bắt đầu để bạn không làm việc quá sức."

#: features.js:661
msgid "A calm theme, no ticking seconds and no end-of-timer rush."
msgstr ""
"Giao diện nhẹ nhàng, không tiếng đếm giây và không hối hả lúc hết giờ."

#: features.js:701
msgid "What will you mainly focus on?"
msgstr "Bạn sẽ chủ yếu tập trung vào điều gì?"

#: features.js:702
msgid "This shapes how long each focus block should be."
msgstr "Điều này quyết định độ dài mỗi khối tập trung."

#: features.js:704
msgid "Deep work or coding"
msgstr "Làm việc chuyên sâu hoặc lập trình"

#: features.js:705
msgid "Studying or reading"
msgstr "Học hoặc đọc"

#: features.js:706
msgid "Writing or creative work"
msgstr "Viết lách hoặc công việc sáng tạo"

#: features.js:707
msgid "Lots of small tasks"
msgstr "Nhiều việc nhỏ"

#: features.js:709
msgid "How long can you usually concentrate?"
msgstr "Bạn thường tập trung được bao lâu?"

#: features.js:710
msgid "Pick a length you can actually keep — it beats an ideal one."
msgstr "Chọn độ dài bạn thực sự duy trì được — hơn là chọn mức lý tưởng."

#: features.js:712
msgid "About 15 minutes"
msgstr "Khoảng 15 phút"

#: features.js:713
msgid "About 25 minutes"
msgstr "Khoảng 25 phút"

#: features.js:714
msgid "45 minutes or more"
msgstr "45 phút trở lên"

#: features.js:715
msgid "I lose track of time when I'm in flow"
msgstr "Tôi quên cả thời gian khi vào guồng"

#: features.js:717
msgid "What gets in your way most?"
msgstr "Điều gì cản trở bạn nhiều nhất?"

#: features.js:718
msgid "I'll switch on the right help for this."
msgstr "Tôi sẽ bật trợ giúp phù hợp cho việc này."

#: features.js:720
msgid "Notifications and pings"
msgstr "Thông báo và tiếng báo"

#: features.js:721
msgid "Distracting websites"
msgstr "Trang web gây xao nhãng"

#: features.js:722
msgid "It's hard to get started"
msgstr "Khó bắt đầu"

#: features.js:723
msgid "I forget to take breaks"
msgstr "Tôi quên nghỉ ngơi"

#: features.js:724
msgid "Timers make me anxious"
msgstr "Bộ đếm khiến tôi lo lắng"

#: features.js:726
msgid "What helps you concentrate?"
msgstr "Điều gì giúp bạn tập trung?"

#: features.js:727
msgid "Sets the focus soundscape — change it anytime in Sounds."
msgstr "Thiết lập âm thanh tập trung — đổi bất cứ lúc nào trong Âm thanh."

#: features.js:729
msgid "Silence"
msgstr "Yên lặng"

#: features.js:730
msgid "Soft background noise"
msgstr "Tiếng nền nhẹ nhàng"

#: features.js:731
msgid "A gentle chime to mark time"
msgstr "Chuông nhẹ để đánh dấu thời gian"

#: features.js:732
msgid "I share my space — keep it quiet"
msgstr "Tôi ở không gian chung — giữ yên tĩnh"

#: features.js:734
msgid "How much do you want to get done today?"
msgstr "Hôm nay bạn muốn làm được bao nhiêu?"

#: features.js:735
msgid "Sets your daily goal — no pressure, you can change it."
msgstr "Đặt mục tiêu ngày — không áp lực, bạn có thể đổi."

#: features.js:737
msgid "Just trying it out"
msgstr "Chỉ thử cho biết"

#: features.js:738
msgid "A light day (about 4)"
msgstr "Một ngày nhẹ nhàng (khoảng 4)"

#: features.js:739
msgid "A full day (about 6)"
msgstr "Một ngày trọn vẹn (khoảng 6)"

#: features.js:740
msgid "A big push (about 8)"
msgstr "Bứt phá lớn (khoảng 8)"

#: features.js:756
msgid "Smart setup"
msgstr "Thiết lập thông minh"

#: features.js:765
msgid "Skip"
msgstr "Bỏ qua"

#: features.js:768
msgid "Let's tune Zen Pomodoro to you 🍅"
msgstr "Hãy điều chỉnh Zen Pomodoro theo bạn 🍅"

#: features.js:769
msgid ""
"Answer five quick questions and I'll build a focus setup that fits how you "
"work — your rhythm, sounds, breaks and the help you need. You can fine-tune "
"everything later in Settings."
msgstr ""
"Trả lời năm câu hỏi nhanh và tôi sẽ dựng một thiết lập tập trung hợp với "
"cách bạn làm việc — nhịp độ, âm thanh, giờ nghỉ và sự trợ giúp bạn cần. Bạn "
"có thể tinh chỉnh mọi thứ sau trong Cài đặt."

#: features.js:770
msgid "Let's go"
msgstr "Bắt đầu thôi"

#: features.js:776 features.js:792
msgid "Back"
msgstr "Quay lại"

#: features.js:777
msgid "Next"
msgstr "Tiếp"

#: features.js:780
msgid "Your tailored setup 🍅"
msgstr "Thiết lập riêng cho bạn 🍅"

#: features.js:781
msgid ""
"Based on your answers, here's what I'll set up. Apply it now, then tweak "
"anything in Settings."
msgstr ""
"Dựa trên câu trả lời của bạn, đây là những gì tôi sẽ thiết lập. Áp dụng "
"ngay, rồi tinh chỉnh tuỳ ý trong Cài đặt."

#: features.js:793
msgid "Apply"
msgstr "Áp dụng"

#: features.js:794
msgid "Apply & start"
msgstr "Áp dụng và bắt đầu"

