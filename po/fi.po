#: features.js:724
#, javascript-format
msgid "Focus rhythm %d / %d / %d min — %s."
msgstr "Fokusrytmi %d / %d / %d min — %s."

#: features.js:730
#, javascript-format
msgid "Daily goal: %d focus blocks."
msgstr "Päivätavoite: %d fokusjaksoa."

#: features.js:731
msgid "No daily goal yet — just getting a feel for it."
msgstr "Ei vielä päivätavoitetta — vasta tunnustellaan."

#: features.js:742
msgid "Silent focus — no ticking or chimes."
msgstr "Hiljainen fokus — ei tikitystä eikä kilahduksia."

#: features.js:746
msgid "Soft brown-noise ambience while you focus."
msgstr "Pehmeä ruskean kohinan tausta keskittyessäsi."

#: features.js:751
#, javascript-format
msgid "A gentle chime every %d min to mark time."
msgstr "Hellävarainen kilahdus %d min välein ajan merkiksi."

#: features.js:756
msgid "Quiet, visual-only cues for a shared space."
msgstr "Hiljaiset, vain visuaaliset vihjeet jaettuun tilaan."

#: features.js:762
msgid "Notifications are muted while you focus."
msgstr "Ilmoitukset vaimennetaan keskittyessäsi."

#: features.js:765
msgid "Distraction blocking is ready — add sites in Settings → Advanced."
msgstr ""
"Häiriöiden esto on valmis — lisää sivustot kohdassa Asetukset → "
"Lisäasetukset."

#: features.js:768
msgid "One-click start and a calm start ritual make it easier to begin."
msgstr ""
"Yhden napsautuksen aloitus ja rauhallinen aloitusrituaali helpottavat alkuun "
"pääsyä."

#: features.js:772
msgid "Breaks start on their own so you don't overwork."
msgstr "Tauot alkavat itsestään, ettet tee liikaa töitä."

#: features.js:776
msgid "A calm theme, no ticking seconds and no end-of-timer rush."
msgstr ""
"Rauhallinen teema, ei tikittäviä sekunteja eikä kiirettä ajastimen lopussa."

#: features.js:816
msgid "What will you mainly focus on?"
msgstr "Mihin keskityt pääasiassa?"

#: features.js:817
msgid "This shapes how long each focus block should be."
