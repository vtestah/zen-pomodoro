#: features.js:201
#, javascript-format
msgid "%d focus blocks today — great work!"
msgstr "%d bloków skupienia dzisiaj — świetna robota!"

#: features.js:203
#, javascript-format
msgid "🔥 %d-day streak"
msgstr "🔥 seria %d dni"

#: features.js:205
msgid "Daily goal reached 🍅"
msgstr "Cel dzienny osiągnięty 🍅"

#: features.js:438
msgid "Look ~20 ft away for 20 seconds — rest your eyes."
msgstr "Spójrz w dal na 20 sekund — daj odpocząć oczom."

#: features.js:439
msgid "Stand up and stretch."
msgstr "Wstań i rozciągnij się."

#: features.js:440
msgid "Drink some water."
msgstr "Napij się wody."

#: features.js:441
msgid "Look out a window and relax your shoulders."
msgstr "Spójrz przez okno i rozluźnij ramiona."

#: features.js:442
msgid "Close your eyes and take a few slow breaths."
msgstr "Zamknij oczy i weź kilka powolnych oddechów."

#: features.js:445
msgid "Take a short walk."
msgstr "Przejdź się chwilę."

#: features.js:446
msgid "Step outside for some fresh air."
msgstr "Wyjdź na świeże powietrze."

#: features.js:447
msgid "Stretch and move around a little."
msgstr "Rozciągnij się i trochę poruszaj."

#: features.js:448
msgid "Grab a snack and some water."
msgstr "Zjedz przekąskę i napij się wody."

#: features.js:449
msgid "Rest your eyes and look into the distance."
msgstr "Daj odpocząć oczom — spójrz w dal."

#: features.js:460
msgid "New task"
msgstr "Nowe zadanie"

#: features.js:461
msgid "What do you want to work on?"
