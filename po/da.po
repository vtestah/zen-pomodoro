#: features.js:735
#, javascript-format
msgid "Daily goal: %d focus blocks."
msgstr "Dagligt mål: %d fokusblokke."

#: features.js:736
msgid "No daily goal yet — just getting a feel for it."
msgstr "Intet dagligt mål endnu — vi prøver os bare frem."

#: features.js:747
msgid "Silent focus — no ticking or chimes."
msgstr "Stille fokus — ingen tikken eller klokketoner."

#: features.js:751
msgid "Soft brown-noise ambience while you focus."
msgstr "Blød brun-støj-stemning, mens du fokuserer."

#: features.js:756
#, javascript-format
msgid "A gentle chime every %d min to mark time."
msgstr "En blid klokketone hvert %d min for at markere tiden."

#: features.js:761
msgid "Quiet, visual-only cues for a shared space."
msgstr "Stille, kun visuelle signaler til et fælles rum."

#: features.js:767
msgid "Notifications are muted while you focus."
msgstr "Notifikationer dæmpes, mens du fokuserer."

#: features.js:770
msgid "Distraction blocking is ready — add sites in Settings → Advanced."
msgstr ""
"Blokering af forstyrrelser er klar — tilføj websteder i Indstillinger → "
"Avanceret."

#: features.js:773
msgid "One-click start and a calm start ritual make it easier to begin."
msgstr ""
"Start med ét klik og et roligt startritual gør det lettere at komme i gang."

#: features.js:777
msgid "Breaks start on their own so you don't overwork."
msgstr "Pauser starter af sig selv, så du ikke overanstrenger dig."

#: features.js:781
msgid "A calm theme, no ticking seconds and no end-of-timer rush."
msgstr ""
"Et roligt tema, ingen tikkende sekunder og intet stress, når timeren "
"slutter."

#: features.js:821
msgid "What will you mainly focus on?"
msgstr "Hvad vil du hovedsageligt fokusere på?"

#: features.js:822
msgid "This shapes how long each focus block should be."
msgstr "Det afgør, hvor lang hver fokusblok skal være."

