msgstr ""

#. settings-schema.json->focus_ambient_choice->options
msgid "Pink noise"
msgstr ""

#. settings-schema.json->focus_ambient_choice->options
msgid "Brown noise"
msgstr ""

#. settings-schema.json->focus_ambient_choice->options
msgid "Rain"
msgstr ""

#. settings-schema.json->focus_ambient_choice->options
msgid "Sea"
msgstr ""

