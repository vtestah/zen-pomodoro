# --- settings-schema.json descriptions ---
msgid "Durations (minutes)"
msgstr "Длительности (минуты)"

msgid "Pomodoro Duration:"
msgstr "Длительность помидора:"

msgid "Short Break Duration:"
msgstr "Длительность короткого перерыва:"

msgid "Long Break Duration:"
msgstr "Длительность длинного перерыва:"

msgid "Number of pomodori before long break:"
msgstr "Помидоров до длинного перерыва:"

msgid "Options"
msgstr "Параметры"

msgid "Start the pomodoro timer as soon as the applet loads"
msgstr "Запускать таймер сразу при загрузке апплета"

msgid ""
"Recover an in-progress focus session after a Cinnamon restart (resume "
"manually)"
msgstr ""
"Восстанавливать незавершённую сессию фокуса после перезапуска Cinnamon "
"(продолжить вручную)"

msgid "Show Dialog Messages"
msgstr "Показывать диалоговые сообщения"

msgid "Auto start after a pomodoro ends"
msgstr "Автостарт после завершения помидора"

msgid "Auto start after a short break ends"
msgstr "Автостарт после короткого перерыва"

msgid "Auto start a new pomodoro after a break ends"
msgstr "Автостарт нового помидора после перерыва"

msgid "Display the pomodoro icon in the applet panel"
msgstr "Показывать иконку помидора на панели"

msgid "Use a symbolic icon in the applet panel"
msgstr "Использовать символьную иконку на панели"

msgid "Show the pomodoro timer in the applet panel"
msgstr "Показывать таймер на панели"

msgid "Set the keybinding to open the applet menu"
msgstr "Горячая клавиша для открытия меню апплета"

msgid "Focus HUD"
msgstr "Индикаторы фокуса"

msgid "Show the current task as an on-screen chip during focus"
msgstr "Показывать текущую задачу плашкой на экране во время фокуса"

msgid "Calm ending: no anxious pulsing near the end of a timer"
msgstr "Спокойная концовка: без тревожного мигания в конце таймера"

msgid ""
"Start ritual: brief centered 'Focus: <task>' and a smooth fade-in when focus"
" begins"
msgstr ""
"Ритуал старта: короткая надпись «Фокус: <задача>» по центру и плавное "
"появление в начале фокуса"

msgid ""
"Glow frame: soft edge glow with progress around the screen (off = classic "
"border)"
msgstr ""
"Свечение-рамка: мягкое свечение по краям с прогрессом (выкл = классическая "
"рамка)"

msgid "Sounds"
msgstr "Звуки"

msgid "Please install 'sox' and restart Cinnamon to use the sound feature!"
msgstr "Установите «sox» и перезапустите Cinnamon, чтобы использовать звук!"

msgid "Play Timer Sound"
msgstr "Воспроизводить звук тикания"

msgid "Timer Sound File"
msgstr "Файл звука тикания"

msgid "Sound volume:"
msgstr "Громкость:"

msgid "Play Break Sound"
msgstr "Воспроизводить звук перерыва"

msgid "Break Sound File"
msgstr "Файл звука перерыва"

msgid "Play Warn Sound"
msgstr "Воспроизводить звук предупреждения"

msgid "Warn Delay (in secs):"
msgstr "Задержка предупреждения (сек):"

msgid "Warn Sound File"
msgstr "Файл звука предупреждения"

msgid "Play Start Sound"
msgstr "Воспроизводить звук старта"

msgid "Start Sound File"
msgstr "Файл звука старта"

msgid "Scripts"
msgstr "Скрипты"

msgid "Enable scripts"
msgstr "Включить скрипты"

msgid "Execute this custom script when a short break starts"
msgstr "Выполнять этот скрипт при начале короткого перерыва"

msgid "Execute this custom script when a long break starts"
msgstr "Выполнять этот скрипт при начале длинного перерыва"

# --- Distinctive features ---
