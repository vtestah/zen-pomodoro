#: features.js:438
msgid "Look ~20 ft away for 20 seconds — rest your eyes."
msgstr "Pogledajte u daljinu 20 sekundi — odmorite oči."

#: features.js:439
msgid "Stand up and stretch."
msgstr "Ustanite i protegnite se."

#: features.js:440
msgid "Drink some water."
msgstr "Popijte malo vode."

#: features.js:441
msgid "Look out a window and relax your shoulders."
msgstr "Pogledajte kroz prozor i opustite ramena."

#: features.js:442
msgid "Close your eyes and take a few slow breaths."
msgstr "Zatvorite oči i polako udahnite nekoliko puta."

#: features.js:445
msgid "Take a short walk."
msgstr "Prošećite malo."

#: features.js:446
msgid "Step outside for some fresh air."
