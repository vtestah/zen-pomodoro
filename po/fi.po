"kaikkea myöhemmin Asetuksissa."

#: features.js:885
msgid "Let's go"
msgstr "Aloitetaan"

#: features.js:891 features.js:907
msgid "Back"
msgstr "Takaisin"

#: features.js:892
msgid "Next"
msgstr "Seuraava"

#: features.js:895
