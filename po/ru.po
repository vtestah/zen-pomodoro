#: features.js:565
msgid "longer focus blocks suit deep work"
msgstr "длинные интервалы подходят для глубокой работы"

#: features.js:566
msgid "the classic rhythm suits studying"
msgstr "классический ритм подходит для учёбы"

#: features.js:567
msgid "a little more break time lets ideas settle"
msgstr "чуть больше времени на перерыв помогает идеям улечься"

#: features.js:568
msgid "shorter cycles keep small tasks moving"
msgstr "короткие циклы помогают двигать мелкие задачи"

#: features.js:569
msgid "a balanced rhythm"
msgstr "сбалансированный ритм"

#: features.js:570
#, javascript-format
msgid "Focus rhythm %d / %d / %d min — %s."
msgstr "Ритм фокуса %d / %d / %d мин — %s."

#: features.js:576
#, javascript-format
msgid "Daily goal: %d focus blocks."
msgstr "Дневная цель: %d интервалов фокуса."

#: features.js:577
msgid "No daily goal yet — just getting a feel for it."
msgstr "Пока без дневной цели — просто пробуем."

#: features.js:588
msgid "Silent focus — no ticking or chimes."
msgstr "Тихий фокус — без тиканья и сигналов."

#: features.js:592
msgid "Soft brown-noise ambience while you focus."
msgstr "Мягкий коричневый шум во время фокуса."

#: features.js:597
#, javascript-format
msgid "A gentle chime every %d min to mark time."
msgstr "Мягкий сигнал каждые %d мин, чтобы отмечать время."

#: features.js:602
msgid "Quiet, visual-only cues for a shared space."
msgstr "Тихие, только визуальные подсказки для общего пространства."

#: features.js:608
msgid "Notifications are muted while you focus."
msgstr "Уведомления отключаются во время фокуса."

#: features.js:611
msgid "Distraction blocking is ready — add sites in Settings → Advanced."
msgstr ""
"Блокировка отвлечений готова — добавьте сайты в Настройки → Дополнительно."

#: features.js:614
msgid "One-click start and a calm start ritual make it easier to begin."
msgstr "Запуск одним кликом и спокойный ритуал старта помогают начать."

#: features.js:618
msgid "Breaks start on their own so you don't overwork."
msgstr "Перерывы начинаются сами, чтобы вы не переработали."

#: features.js:622
msgid "A calm theme, no ticking seconds and no end-of-timer rush."
msgstr "Спокойная тема, без тиканья секунд и спешки в конце таймера."

#: features.js:662
msgid "What will you mainly focus on?"
msgstr "На чём вы будете в основном сосредоточены?"

#: features.js:663
msgid "This shapes how long each focus block should be."
msgstr "От этого зависит длина каждого интервала фокуса."

#: features.js:665
msgid "Deep work or coding"
msgstr "Глубокая работа или код"

#: features.js:666
msgid "Studying or reading"
msgstr "Учёба или чтение"

#: features.js:667
msgid "Writing or creative work"
msgstr "Письмо или творческая работа"

#: features.js:668
msgid "Lots of small tasks"
msgstr "Много мелких задач"

#: features.js:670
msgid "How long can you usually concentrate?"
msgstr "Сколько вы обычно можете концентрироваться?"

#: features.js:671
msgid "Pick a length you can actually keep — it beats an ideal one."
msgstr ""
"Выберите длительность, которую реально выдержите — это лучше идеальной."

#: features.js:673
msgid "About 15 minutes"
msgstr "Около 15 минут"

#: features.js:674
msgid "About 25 minutes"
msgstr "Около 25 минут"

#: features.js:675
msgid "45 minutes or more"
msgstr "45 минут или больше"

#: features.js:676
msgid "I lose track of time when I'm in flow"
msgstr "Я теряю счёт времени, когда в потоке"

#: features.js:678
msgid "What gets in your way most?"
msgstr "Что мешает вам больше всего?"

#: features.js:679
msgid "I'll switch on the right help for this."
msgstr "Я включу подходящую помощь для этого."

#: features.js:681
msgid "Notifications and pings"
msgstr "Уведомления и сигналы"

#: features.js:682
msgid "Distracting websites"
msgstr "Отвлекающие сайты"

#: features.js:683
msgid "It's hard to get started"
msgstr "Трудно начать"

#: features.js:684
msgid "I forget to take breaks"
msgstr "Я забываю делать перерывы"

#: features.js:685
msgid "Timers make me anxious"
msgstr "Таймеры вызывают у меня тревогу"

#: features.js:687
msgid "What helps you concentrate?"
msgstr "Что помогает вам сосредоточиться?"

#: features.js:688
msgid "Sets the focus soundscape — change it anytime in Sounds."
msgstr ""
"Задаёт звуки фокуса — их можно изменить в любой момент в разделе «Звуки»."

#: features.js:690
msgid "Silence"
msgstr "Тишина"

#: features.js:691
msgid "Soft background noise"
msgstr "Мягкий фоновый шум"

#: features.js:692
msgid "A gentle chime to mark time"
msgstr "Мягкий сигнал, чтобы отмечать время"

#: features.js:693
msgid "I share my space — keep it quiet"
msgstr "Я в общем пространстве — потише"

#: features.js:695
msgid "How much do you want to get done today?"
msgstr "Сколько вы хотите успеть сегодня?"

#: features.js:696
msgid "Sets your daily goal — no pressure, you can change it."
msgstr "Задаёт дневную цель — без давления, её можно изменить."

#: features.js:698
msgid "Just trying it out"
msgstr "Просто пробую"

#: features.js:699
msgid "A light day (about 4)"
