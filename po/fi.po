#: features.js:720
msgid "the classic rhythm suits studying"
msgstr "klassinen rytmi sopii opiskeluun"

#: features.js:721
msgid "a little more break time lets ideas settle"
msgstr "hieman enemmän taukoaikaa antaa ideoiden asettua"

#: features.js:722
msgid "shorter cycles keep small tasks moving"
msgstr "lyhyemmät syklit pitävät pienet tehtävät liikkeessä"

#: features.js:723
msgid "a balanced rhythm"
