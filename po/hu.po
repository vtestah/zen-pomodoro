#: dialogs.js:259
msgid "Continue Current Pomodoro"
msgstr "Jelenlegi pomodoro folytatása"

#: dialogs.js:271
msgid "Short break finished, ready to continue?"
msgstr "A rövid szünet véget ért, készen áll a folytatásra?"

#: dialogs.js:313
#, javascript-format
msgid "Extend +%d min"
msgstr "Hosszabbítás +%d perc"

#: dialogs.js:320
msgid "Start break"
msgstr "Kezdje a szünetet"

#: dialogs.js:330
msgid "Pomodoro finished, ready to take a break?"
msgstr "Pomodoro végzett, készen áll a szünetre?"

#: features.js:201
#, javascript-format
msgid "%d focus blocks today — great work!"
msgstr "%d fókuszblokk ma — nagyszerű munka!"

#: features.js:203
#, javascript-format
msgid "🔥 %d-day streak"
msgstr "🔥 %d napos sorozat"

#: features.js:205
msgid "Daily goal reached 🍅"
msgstr "Napi cél elérve 🍅"

#: features.js:421
#, javascript-format
msgid "Hit your %d 🍅 estimate for: %s. Mark it done when ready."
msgstr ""
"Elérted a(z) %d 🍅 becslést ehhez: %s. Jelöld késznek, amikor készen állsz."

#: features.js:456
msgid "Look ~20 ft away for 20 seconds — rest your eyes."
msgstr "Nézz kb. 6 méterre 20 másodpercig — pihentesd a szemed."

#: features.js:457
msgid "Stand up and stretch."
msgstr "Állj fel és nyújtózz egyet."

#: features.js:458
msgid "Drink some water."
msgstr "Igyál egy kis vizet."

#: features.js:459
msgid "Look out a window and relax your shoulders."
msgstr "Nézz ki az ablakon és lazítsd el a vállad."

#: features.js:460
msgid "Close your eyes and take a few slow breaths."
msgstr "Csukd be a szemed és végy néhány lassú levegőt."

#: features.js:463
msgid "Take a short walk."
msgstr "Sétálj egy rövidet."

#: features.js:464
msgid "Step outside for some fresh air."
msgstr "Menj ki egy kis friss levegőre."

#: features.js:465
msgid "Stretch and move around a little."
msgstr "Nyújtózz és mozogj egy kicsit."

#: features.js:466
msgid "Grab a snack and some water."
msgstr "Kapj be egy falatot és igyál vizet."

#: features.js:467
msgid "Rest your eyes and look into the distance."
msgstr "Pihentesd a szemed és nézz a távolba."

#: features.js:478 menu.js:873
msgid "Edit task"
msgstr "Feladat szerkesztése"

#: features.js:478
msgid "New task"
msgstr "Új feladat"

#: features.js:479
msgid "What do you want to work on?"
msgstr "Min szeretnél dolgozni?"

#: features.js:487
msgid "Estimate:"
msgstr "Becslés:"

#: features.js:522
msgid "Save"
msgstr "Mentés"

#: features.js:522
msgid "Add"
msgstr "Hozzáadás"

#: features.js:566
msgid "longer focus blocks suit deep work"
msgstr "a hosszabb fókuszblokkok a mélymunkához valók"

#: features.js:567
msgid "the classic rhythm suits studying"
msgstr "a klasszikus ritmus a tanuláshoz illik"

#: features.js:568
msgid "a little more break time lets ideas settle"
msgstr "egy kis plusz szünet hagyja leülepedni a gondolatokat"

#: features.js:569
msgid "shorter cycles keep small tasks moving"
msgstr "a rövidebb ciklusok mozgásban tartják az apró feladatokat"

#: features.js:570
msgid "a balanced rhythm"
msgstr "kiegyensúlyozott ritmus"

#: features.js:571
#, javascript-format
msgid "Focus rhythm %d / %d / %d min — %s."
msgstr "Fókuszritmus: %d / %d / %d perc — %s."

#: features.js:577
#, javascript-format
msgid "Daily goal: %d focus blocks."
msgstr "Napi cél: %d fókuszblokk."

#: features.js:578
msgid "No daily goal yet — just getting a feel for it."
msgstr "Még nincs napi cél — csak ráérzünk."

#: features.js:589
msgid "Silent focus — no ticking or chimes."
msgstr "Csendes fókusz — ketyegés és csengő nélkül."

#: features.js:593
msgid "Soft brown-noise ambience while you focus."
msgstr "Lágy barnazaj-háttér fókuszálás közben."

#: features.js:598
#, javascript-format
msgid "A gentle chime every %d min to mark time."
msgstr "Finom csengő %d percenként az idő jelzésére."

#: features.js:603
msgid "Quiet, visual-only cues for a shared space."
msgstr "Csendes, csak vizuális jelzések közös térhez."

#: features.js:609
msgid "Notifications are muted while you focus."
msgstr "Az értesítések némítva vannak fókuszálás közben."

#: features.js:612
msgid "Distraction blocking is ready — add sites in Settings → Advanced."
msgstr ""
"A figyelemelterelés-blokkolás kész — adj hozzá oldalakat itt: Beállítások → "
"Speciális."

#: features.js:615
msgid "One-click start and a calm start ritual make it easier to begin."
msgstr ""
"Az egykattintásos indítás és a nyugodt kezdő rituálé megkönnyíti a "
"belekezdést."

#: features.js:619
msgid "Breaks start on their own so you don't overwork."
msgstr "A szünetek maguktól indulnak, hogy ne hajszold túl magad."

#: features.js:623
msgid "A calm theme, no ticking seconds and no end-of-timer rush."
msgstr "Nyugodt téma, ketyegő másodpercek és időzítővégi hajsza nélkül."

#: features.js:663
msgid "What will you mainly focus on?"
msgstr "Mire fogsz főként fókuszálni?"

#: features.js:664
msgid "This shapes how long each focus block should be."
msgstr "Ez határozza meg, milyen hosszú legyen egy-egy fókuszblokk."

#: features.js:666
msgid "Deep work or coding"
msgstr "Mélymunka vagy kódolás"

#: features.js:667
msgid "Studying or reading"
msgstr "Tanulás vagy olvasás"

#: features.js:668
msgid "Writing or creative work"
msgstr "Írás vagy kreatív munka"

#: features.js:669
msgid "Lots of small tasks"
msgstr "Sok apró feladat"

#: features.js:671
msgid "How long can you usually concentrate?"
msgstr "Általában meddig tudsz koncentrálni?"

#: features.js:672
msgid "Pick a length you can actually keep — it beats an ideal one."
msgstr ""
"Olyan hosszt válassz, amit valóban tartani tudsz — ez jobb az ideálisnál."

#: features.js:674
msgid "About 15 minutes"
msgstr "Körülbelül 15 perc"

#: features.js:675
msgid "About 25 minutes"
msgstr "Körülbelül 25 perc"

#: features.js:676
msgid "45 minutes or more"
msgstr "45 perc vagy több"

#: features.js:677
msgid "I lose track of time when I'm in flow"
msgstr "Elveszítem az időérzékem, amikor flow-ban vagyok"

#: features.js:679
msgid "What gets in your way most?"
msgstr "Mi zavar a legjobban?"

#: features.js:680
msgid "I'll switch on the right help for this."
msgstr "Bekapcsolom ehhez a megfelelő segítséget."

#: features.js:682
msgid "Notifications and pings"
msgstr "Értesítések és csipogások"

#: features.js:683
msgid "Distracting websites"
msgstr "Figyelemelterelő weboldalak"

#: features.js:684
msgid "It's hard to get started"
msgstr "Nehéz belekezdeni"

#: features.js:685
msgid "I forget to take breaks"
msgstr "Elfelejtek szünetet tartani"

#: features.js:686
msgid "Timers make me anxious"
msgstr "Az időzítők szorongást keltenek bennem"

#: features.js:688
msgid "What helps you concentrate?"
msgstr "Mi segít a koncentrálásban?"

#: features.js:689
msgid "Sets the focus soundscape — change it anytime in Sounds."
msgstr "Beállítja a fókusz hangzását — bármikor módosítható a Hangok résznél."

#: features.js:691
msgid "Silence"
msgstr "Csend"

#: features.js:692
msgid "Soft background noise"
msgstr "Lágy háttérzaj"

#: features.js:693
msgid "A gentle chime to mark time"
msgstr "Finom csengő az idő jelzésére"

#: features.js:694
msgid "I share my space — keep it quiet"
msgstr "Közös térben vagyok — legyen csendes"

#: features.js:696
msgid "How much do you want to get done today?"
msgstr "Mennyit szeretnél ma elvégezni?"

#: features.js:697
msgid "Sets your daily goal — no pressure, you can change it."
msgstr "Beállítja a napi célodat — nyomás nélkül, bármikor módosíthatod."

#: features.js:699
msgid "Just trying it out"
msgstr "Csak kipróbálom"

#: features.js:700
msgid "A light day (about 4)"
msgstr "Könnyű nap (kb. 4)"

#: features.js:701
msgid "A full day (about 6)"
msgstr "Teljes nap (kb. 6)"

#: features.js:702
msgid "A big push (about 8)"
msgstr "Nagy hajrá (kb. 8)"

#: features.js:718
msgid "Smart setup"
msgstr "Okos beállítás"

#: features.js:727
msgid "Skip"
msgstr "Kihagyás"

#: features.js:730
msgid "Let's tune Zen Pomodoro to you 🍅"
msgstr "Hangoljuk a Zen Pomodorót rád 🍅"

#: features.js:731
msgid ""
"Answer five quick questions and I'll build a focus setup that fits how you "
"work — your rhythm, sounds, breaks and the help you need. You can fine-tune "
"everything later in Settings."
msgstr ""
"Válaszolj öt gyors kérdésre, és összeállítok egy fókuszbeállítást a "
"munkamódodhoz — a ritmusod, hangok, szünetek és a szükséges segítség. "
"Mindent finomhangolhatsz később a Beállításokban."

#: features.js:732
msgid "Let's go"
msgstr "Kezdjük"

#: features.js:738 features.js:754
msgid "Back"
msgstr "Vissza"

#: features.js:739
msgid "Next"
msgstr "Tovább"

#: features.js:742
msgid "Your tailored setup 🍅"
msgstr "A személyre szabott beállításod 🍅"

#: features.js:743
msgid ""
"Based on your answers, here's what I'll set up. Apply it now, then tweak "
"anything in Settings."
msgstr ""
"A válaszaid alapján ezt fogom beállítani. Alkalmazd most, majd bármit "
"finomíthatsz a Beállításokban."

#: features.js:755
msgid "Apply"
msgstr "Alkalmaz"

#: features.js:756
msgid "Apply & start"
msgstr "Alkalmaz és indít"

