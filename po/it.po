#: features.js:604
msgid "longer focus blocks suit deep work"
msgstr "blocchi di focus più lunghi sono adatti al lavoro profondo"

#: features.js:605
msgid "the classic rhythm suits studying"
msgstr "il ritmo classico è adatto allo studio"

#: features.js:606
msgid "a little more break time lets ideas settle"
msgstr "un po' più di pausa lascia sedimentare le idee"

#: features.js:607
msgid "shorter cycles keep small tasks moving"
msgstr "cicli più brevi fanno avanzare le piccole attività"

#: features.js:608
msgid "a balanced rhythm"
msgstr "un ritmo equilibrato"

#: features.js:609
#, javascript-format
msgid "Focus rhythm %d / %d / %d min — %s."
msgstr "Ritmo di focus %d / %d / %d min — %s."

#: features.js:615
#, javascript-format
msgid "Daily goal: %d focus blocks."
msgstr "Obiettivo giornaliero: %d blocchi di focus."

#: features.js:616
msgid "No daily goal yet — just getting a feel for it."
msgstr "Ancora nessun obiettivo giornaliero — per ora proviamo."

#: features.js:627
msgid "Silent focus — no ticking or chimes."
msgstr "Focus silenzioso — niente ticchettio né segnali."

#: features.js:631
msgid "Soft brown-noise ambience while you focus."
msgstr "Un leggero rumore marrone di sottofondo mentre ti concentri."

#: features.js:636
#, javascript-format
msgid "A gentle chime every %d min to mark time."
msgstr "Un segnale delicato ogni %d min per scandire il tempo."

#: features.js:641
msgid "Quiet, visual-only cues for a shared space."
msgstr "Segnali silenziosi e solo visivi per spazi condivisi."

#: features.js:647
msgid "Notifications are muted while you focus."
msgstr "Le notifiche sono silenziate mentre ti concentri."

#: features.js:650
msgid "Distraction blocking is ready — add sites in Settings → Advanced."
msgstr ""
"Blocco delle distrazioni pronto — aggiungi i siti in Impostazioni → "
"Avanzate."

#: features.js:653
msgid "One-click start and a calm start ritual make it easier to begin."
msgstr ""
"L'avvio con un clic e un rituale di inizio tranquillo rendono più facile "
"cominciare."

#: features.js:657
msgid "Breaks start on their own so you don't overwork."
msgstr "Le pause partono da sole, così non lavori troppo."

#: features.js:661
msgid "A calm theme, no ticking seconds and no end-of-timer rush."
msgstr ""
"Un tema tranquillo, senza ticchettio dei secondi né fretta a fine timer."

#: features.js:701
msgid "What will you mainly focus on?"
msgstr "Su cosa ti concentrerai principalmente?"

#: features.js:702
msgid "This shapes how long each focus block should be."
msgstr "Definisce la durata di ogni blocco di focus."

#: features.js:704
msgid "Deep work or coding"
