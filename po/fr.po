msgstr ""
"Exécuter vos scripts personnels ~/.local/bin/pomodoro. Désactivé = fonctions"
" intégrées uniquement."

#. settings-schema.json->custom_short_break_script->description
msgid "Execute this custom script when a short break starts"
msgstr "Exécuter ce script personnalisé lorsqu'une pause courte commence"

#. settings-schema.json->custom_short_break_script->tooltip
msgid "Script to run when a short break starts."
msgstr "Script à exécuter au début d'une courte pause."

