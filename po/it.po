#: features.js:732
msgid "I share my space — keep it quiet"
msgstr "Condivido lo spazio — mantieni il silenzio"

#: features.js:734
msgid "How much do you want to get done today?"
msgstr "Quanto vuoi fare oggi?"

#: features.js:735
msgid "Sets your daily goal — no pressure, you can change it."
msgstr ""
"Imposta il tuo obiettivo giornaliero — senza pressioni, puoi cambiarlo."

#: features.js:737
msgid "Just trying it out"
msgstr "Sto solo provando"

#: features.js:738
msgid "A light day (about 4)"
