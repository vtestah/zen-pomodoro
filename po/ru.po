msgstr ""
"По вашим ответам вот что я настрою. Примените сейчас, а позже измените что "
"угодно в Настройках."

#: features.js:1012
msgid "Apply"
msgstr "Применить"

#: features.js:1013
msgid "Apply & start"
msgstr "Применить и начать"

