msgid "Daily focus goal (pomodori, 0 = off)"
msgstr "Дневная цель фокуса (помидоров, 0 = выкл)"

msgid "Auto-pause focus when you are away (idle)"
msgstr "Авто-пауза фокуса при простое (нет активности)"

msgid "Idle minutes before auto-pause"
msgstr "Минут простоя до авто-паузы"

msgid "Resume automatically when you return"
msgstr "Автоматически продолжать при возвращении"

