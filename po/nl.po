msgstr "Geluidsbestand dat wordt afgespeeld wanneer een pauze begint."

#. settings-schema.json->break_sound_volume->tooltip
msgid "Volume of the break sound (0 = silent)."
msgstr "Volume van het pauzegeluid (0 = stil)."

